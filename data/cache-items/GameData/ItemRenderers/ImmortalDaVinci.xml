<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_wings" fileName="game/particles_large18.rttex" textureSize="64" frame="10,6"/>

    <Animations>
      <SpriteAnimation name="a_equip" sprite="s_wings" animTime="1200" playOnState="Action.Equip" isLoop="true">
        <Frame>7,6</Frame>
      </SpriteAnimation>
      <SequenceAnimation name="a_BackJump" playOnState="Action.Jump">
        <SpriteAnimation name="a_BackJump1" sprite="s_wings" animTime="100">
          <Frame>10,6</Frame>
          <Frame>7,6</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_BackJump2" sprite="s_wings" animTime="200">
          <Frame>8,6</Frame>
          <Frame>9,6</Frame>
          <Frame>10,6</Frame>
          <Frame>10,6</Frame>
        </SpriteAnimation>
      </SequenceAnimation>
      <SpriteAnimation name="a_fall" sprite="s_wings" animTime="1000" playOnState="Action.Fall" isLoop="true">
        <Frame>10,6</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Equip" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Equip" from="Fall|Jump">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Equip|Fall">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Equip|Jump">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="s_wings" offset="-7,-16" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_wings" offset="7,-16" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer>