<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_Pet" fileName="game/particles_large18.rttex" textureSize="64" frame="0,5" />
    <Sprite name="s_punchLines" fileName="game/particles12.rttex" textureSize="32" frame="11,20" />
    <Sprite name="s_curvedFeather" fileName="game/particles12.rttex" textureSize="32" frame="13,20" />
    <Sprite name="s_death" fileName="game/particles_large18.rttex" textureSize="64" frame="0,6" />
    <Sprite name="s_trail" fileName="game/particles12.rttex" textureSize="32" frame="14,20" />
    <Animations>
      <SpriteAnimation name="a_trail" sprite="s_trail" animTime="1200">
        <Frame>19,20</Frame>
        <Frame>14,20</Frame>
        <Frame>15,20</Frame>
        <Frame>16,20</Frame>
        <Frame>17,20</Frame>
        <Frame>18,20</Frame>
        <Frame>19,20</Frame>
        <Frame>19,20</Frame>
        <Frame>19,20</Frame>
        <Frame>19,20</Frame>
        <Frame>19,20</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_death" sprite="s_death" animTime="1000">
        <Frame>6,6</Frame>
        <Frame>0,6</Frame>
        <Frame>1,6</Frame>
        <Frame>2,6</Frame>
        <Frame>3,6</Frame>
        <Frame>4,6</Frame>
        <Frame>5,6</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetIdle" sprite="s_Pet" animTime="700" isLoop="true" playOnState="Action.None">
        <Frame>0,5</Frame>
        <Frame>1,5</Frame>
        <Frame>2,5</Frame>
        <Frame>3,5</Frame>
        <Frame>4,5</Frame>
        <Frame>5,5</Frame>
        <Frame>6,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_PetPunch" sprite="s_Pet" animTime="600" isLoop="true" playOnState="Action.Punch">
        <Frame>7,5</Frame>
        <Frame>8,5</Frame>
        <Frame>9,5</Frame>
        <Frame>10,5</Frame>
        <Frame>11,5</Frame>
        <Frame>12,5</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_curvedFeather" sprite="s_curvedFeather">
        <Frame>13,20</Frame>
        <Frame>14,20</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_punchLines" sprite="s_punchLines">
        <Frame>11,20</Frame>
        <Frame>12,20</Frame>
      </SpriteAnimation>
    </Animations>
    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Spawn" />
          <State name="None" />
          <State name="Punch" />
          <State name="Dying" IsTemporary="true"/>
        </States>
        <Transitions>
          <Transition to="None" from="Punch|Spawn">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction operatorType="NotEqual">DIE</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None|Spawn">
            <Condition type="and">
              <IsAction>PUNCH</IsAction>
              <IsAction operatorType="NotEqual">DIE</IsAction>
            </Condition>
          </Transition>
          <Transition to="Dying" from="None|Punch">
            <Condition>
              <IsAction>DIE</IsAction>
            </Condition>
          </Transition>
          <Transition to="Spawn" from="Dying"/>
        </Transitions>
      </StateMachine>
      <StateMachine name="Motion">
        <States>
          <State name="Idle" />
          <State name="Moving" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Moving">
            <Condition>
              <IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">100</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Moving" from="Idle">
            <Condition>
              <IsVariableFloat name="pet.velocity.length" operator="Greater" abs="true">100</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <ParticleSystems>
      <ParticleSystem name="ps_punchFeathers">
        <Emitter>
          <Set name="offset">8, -24</Set>
          <Set name="lifeTime">0.3</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">3</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_curvedFeather</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Random name="initialScale" min="0.25" max="0.5"/>
          <Random name="targetPosOffset" min="-8,-8" max="8,8"/>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
          <Random name="initialRotationRate" min="-360" max="360"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchLines">
        <Emitter>
          <Set name="offset">8, -24</Set>
          <Set name="lifeTime">0.3</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_punchLines</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
          <Curve name="initialScale">
            <KeyFrame>0, 1, 1</KeyFrame>
            <KeyFrame>1, 2, 1</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.5, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_destroyFeathers">
        <Emitter>
          <Set name="lifeTime">1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">10</Set>
          <Set name="emissionInterval">0.035</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="offset">0,0</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_curvedFeather</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1.5</Set>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 50</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,100"/>
          <Random name="initialRotationRate" min="-360" max="360"/>
          <Curve name="initialScale">
            <KeyFrame>0, 0.65, 0.65</KeyFrame>
            <KeyFrame>1, 0.15, 0.15</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_trail">
        <Emitter>
          <Set name="emissionInterval">0.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">2</Set>
          <Set name="offset">-20,-8</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_trail</Set>
          <Random name="offset" min="-8,-32" max="8,-16" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.6, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="useGravity">true</Set>
          <Set name="initialScale">0.4, 0.4</Set>
          <Set name="lifeTime">1.2</Set>
          <RandomRadial name="initialVelocity" angleRange="230,310" radiusRange="5,25" />
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.7, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Random name="initialAngle" min="0" max="360" />
          <Random name="gravityVector" min="0, 45" max="0, 60" />
          <Random name="initialRotationRate" min="-60" max="60" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_death">
        <Emitter>
          <Set name="lifeTime">1.1</Set>
          <Set name="infParticles">true</Set>
          <Set name="checkParticleNumToEmit">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="offset">0,-32</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_death</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1.0</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <RenderOptions>
      <Default>
        <Set name="NeedRenderPet">true</Set>
        <Set name="PetOffsetDuplication">-48,0</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="HasDeathParticles">true</Set>
        <Set name="IncludeAllActions">true</Set>
      </Default>
    </RenderOptions>
  </Data>
  <RenderRules>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="ps_destroyFeathers" />
    </OnDestroyedTile>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="pointTowardsPunchTarget">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <RenderPet>
      <SpriteRender name="s_Pet" alignment="DOWN_CENTER" onState="Action.None|Action.Punch"/>
      <ParticleSystemUpdate name="ps_death" onState="Action.Dying"/>
      <StopIf>
        <IsTrnsformed>true</IsTrnsformed>
      </StopIf>
      <ParticleSystemUpdate name="ps_punchLines" onState="Action.Punch"/>
      <ParticleSystemUpdate name="ps_punchFeathers" onState="Action.Punch"/>

      <Group onState="Action.None|Action.Punch">
        <ParticleSystemUpdate name="ps_trail" onState="Motion.Moving"/>
      </Group>
    </RenderPet>
  </RenderRules>
</ItemRenderer>
