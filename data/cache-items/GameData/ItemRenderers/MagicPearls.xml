							</SubCondition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>-->
			<StateMachine name="Punch">
				<States>
					<State name="True"/>
					<State name="False"/>
				</States>
				<Transitions>
					<Transition from="False" to="True">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="True" to="False">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="PunchAnim">
				<States>
					<State name="Off"/>
					<State name="Start" ExitTime="0.5" />
					<State name="Continue"/>
					<State name="End" ExitTime="0.25" />
				</States>
				<Transitions>
					<Transition from="Off" to="Start">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Start" to="Continue"/>
					<Transition from="Continue" to="End">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="End" to="Off"/>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left" />
					<State name="Right" />
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition type="or">
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<VariableMap>
			<Set name="pearlRotation">0, 0, 0, 1</Set>
			<Set name="pearlRotationInc">0</Set>
			<Set name="pearlRotation2">0, 0, 0, 1</Set>
			<Set name="pearlRotationInc2">0</Set>
			<Set name="DeltaTime">0</Set>
			<Set name="context.pos">0, 0</Set>
			<Set name="target.pos">0, 0</Set>
			<Set name="initialPos">0, 0</Set>
			<Set name="handOffsetPos">20, -10</Set>
			<Set name="handOffsetPosFacing">0,0</Set>
			<Set name="movingPos">0, 0</Set>
			<Set name="pearlContextOffset">0, 0, 0</Set>
			<Set name="Player.GetFacing">0</Set>
			<Set name="flipX">false</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderInFront>
			<StopIf type="or">
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
			</StopIf>
			<ArithmethicOperation LeftHandVariableName="initialPos" RightHandVariableName="context.pos" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="handOffsetPosFacing" RightHandVariableName="handOffsetPos" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="handOffsetPosFacing.x" RightHandVariableName="Player.GetFacing" OperationType="Multiply"/>
			<ArithmethicOperation LeftHandVariableName="initialPos" RightHandVariableName="handOffsetPosFacing" OperationType="Add"/>
			
			<ArithmethicOperation LeftHandVariableName="movingPos" RightHandVariableName="initialPos" OperationType="Set" onState="PunchAnim.Off"/>
			<ArithmethicOperation LeftHandVariableName="pearlContextOffset" RightHandVariableName="context.pos" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="pearlContextOffset" RightHandVariableName="movingPos" OperationType="Substract" />
			<ArithmethicOperation LeftHandVariableName="pearlContextOffset" RightHandVariableName="-1,-1,1" OperationType="Multiply" />

			<ArithmethicOperation LeftHandVariableName="pearlContextOffset.x" RightHandVariableName="Player.GetFacing" OperationType="Multiply" />

			<ArithmethicOperation LeftHandVariableName="flipX" RightHandVariableName="false" OperationType="Set" onState="Facing.Right" />
			<ArithmethicOperation LeftHandVariableName="flipX" RightHandVariableName="true" OperationType="Set" onState="Facing.Left" />

			<Translate>pearlContextOffset</Translate>
			<Rotate>pearlRotation</Rotate>
			
			<Group>
				<Translate>0,6,0</Translate>
				<Translate onState="PunchAnim.Start|PunchAnim.Continue">0,2,0</Translate>
				<Rotate>pearlRotation2</Rotate>
				<Translate onState="PunchAnim.Start|PunchAnim.Continue">0,4,0</Translate>
				<ParticleSystemUpdate name="ps_Trail1" onState="PunchAnim.Start|PunchAnim.End"/>
				<ParticleSystemRender name="ps_Trail1" />
				<SpriteRender name="s_Pearl"  blend="PREMULTIPLIED_ALPHA" scale="0.25,0.25" drawShadow="false" useFixedRotation="true"/>
				<SpriteRender name="s_PearlGlow"  blend="PREMULTIPLIED_ALPHA" scale="0.25,0.25" drawShadow="false" useFixedRotation="true"/>
			</Group>
			<Group>
				<Translate>-8,0,0</Translate>
				<Translate onState="PunchAnim.Start|PunchAnim.Continue">-2,0,0</Translate>
				<Rotate>pearlRotation2</Rotate>
				<Translate onState="PunchAnim.Start|PunchAnim.Continue">4,0,0</Translate>
				<ParticleSystemUpdate name="ps_Trail2" onState="PunchAnim.Start|PunchAnim.End"/>
				<ParticleSystemRender name="ps_Trail2" />
				<SpriteRender name="s_Pearl"  blend="PREMULTIPLIED_ALPHA" scale="0.25,0.25" drawShadow="false" useFixedRotation="true"/>
				<SpriteRender name="s_PearlGlow"  blend="PREMULTIPLIED_ALPHA" scale="0.25,0.25" drawShadow="false" useFixedRotation="true"/>
			</Group>
			<Group>
				<Translate>0,-6,0</Translate>
				<Translate onState="PunchAnim.Start|PunchAnim.Continue">0,-2,0</Translate>
				<Rotate>pearlRotation2</Rotate>
				<Translate onState="PunchAnim.Start|PunchAnim.Continue">0,-4,0</Translate>
				<ParticleSystemUpdate name="ps_Trail3" onState="PunchAnim.Start|PunchAnim.End"/>
				<ParticleSystemRender name="ps_Trail3" />
				<SpriteRender name="s_Pearl"  blend="PREMULTIPLIED_ALPHA" scale="0.25,0.25" drawShadow="false" useFixedRotation="true"/>
				<SpriteRender name="s_PearlGlow"  blend="PREMULTIPLIED_ALPHA" scale="0.25,0.25" drawShadow="false" useFixedRotation="true"/>
			</Group>
		</RenderInFront>
		<Update>
			<StopIf type="or">
				<IsZombified>true</IsZombified>
				<IsTrnsformed>true</IsTrnsformed>
				<IsRenderMod>RENDER_MOD_MANNEQUIN</IsRenderMod>
			</StopIf>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">-90</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onState="Punch.True">
				<Set name="armName">arm2Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
			<ArithmethicOperation LeftHandVariableName="pearlRotationInc" RightHandVariableName="90" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="pearlRotationInc" RightHandVariableName="DeltaTime" OperationType="Multiply"/>
			<ArithmethicOperation LeftHandVariableName="pearlRotation.x" RightHandVariableName="pearlRotationInc" OperationType="Add"/>

			<ArithmethicOperation LeftHandVariableName="pearlRotationInc2" RightHandVariableName="600" OperationType="Set" />
			<ArithmethicOperation LeftHandVariableName="pearlRotationInc2" RightHandVariableName="DeltaTime" OperationType="Multiply"/>
			<ArithmethicOperation LeftHandVariableName="pearlRotation2.x" RightHandVariableName="pearlRotationInc2" OperationType="Add"/>
		</Update>
		<OnDamagedTile>
			<ParticleSystemUpdate name="ps_Hit"/>
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_Hit"/>
		</OnDestroyedTile>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>
	</RenderRules>
</ItemRenderer>