<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_Pearl" fileName="game/particles12.rttex" textureSize="32" frame="25,18"/>
		<Sprite name="s_PearlGlow" fileName="game/particles12.rttex" textureSize="32" frame="25,19"/>
		<Sprite name="s_GodRay" fileName="game/particles_large17.rttex" textureSize="64" frame="10,6"/>
		<Sprite name="s_Trail" fileName="game/particles9.rttex" textureSize="32" frame="28,23"/>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderFrontArmInTheFront">true</Set>
			</Default>
		</RenderOptions>
		<Animations>
			<SpriteAnimation name="a_GodRay" sprite="s_GodRay">
				<Frame>10, 6</Frame>
				<Frame>11, 6</Frame>
				<Frame>12, 6</Frame>
				<Frame>13, 6</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_Trail" sprite="s_Trail">
				<Frame>28, 23</Frame>
				<Frame>29, 23</Frame>
				<Frame>30, 23</Frame>
			</SpriteAnimation>
			<SpriteCurveAnimation name="a_pearlGlow" isLoop="true" autoPlay="true" sprite="s_PearlGlow" animTime="2000">
				<Curve name="alpha">
					<KeyFrame>0.f, 0.f</KeyFrame>
					<KeyFrame>0.35f, 1.f</KeyFrame>
					<KeyFrame>0.65f, 1.f</KeyFrame>
					<KeyFrame>1.f, 0.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
			<InterpolationVec2Animation name="a_punchStart" variableName="movingPos" targetVariableName="target.pos" animTime="1500" playOnState="PunchAnim.Start"/>
			<InterpolationVec2Animation name="a_punchContinue" variableName="movingPos" targetVariableName="target.pos" animTime="30" isLoop="true" playOnState="PunchAnim.Continue"/>
			<InterpolationVec2Animation name="a_punchEnd" variableName="movingPos" targetVariableName="initialPos" animTime="1000" playOnState="PunchAnim.End"/>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="ps_GodRay" updateStage="RenderHandItem" updateState="Punch.True" renderStage="RenderHandItem">
				<Emitter  attachment="handspotRoot">
					<Set name="offset">-1,9</Set>
					<Set name="lifeTime">0.2</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_GodRay</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="relativeToEmitter">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5,0.5</KeyFrame>
						<KeyFrame>1, 2.6,2.6</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
					<Set name="flipX" source="flipX" />
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Trail1">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="checkParticleNumToEmit">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Trail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialVelocity">0,0</Set>
					<Random name="offset" min="-4,-4" max="4,4"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5,0.5</Set>
					<Random name="initialAngle" min="0" max="180"/>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Trail2">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="checkParticleNumToEmit">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Trail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialVelocity">0,0</Set>
					<Random name="offset" min="-4,-4" max="4,4"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5,0.5</Set>
					<Random name="initialAngle" min="0" max="180"/>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Trail3">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.05</Set>
					<Set name="checkParticleNumToEmit">false</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0.1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Trail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialVelocity">0,0</Set>
					<Random name="offset" min="-4,-4" max="4,4"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialScale">0.5,0.5</Set>
					<Random name="initialAngle" min="0" max="180"/>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_Hit">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">6</Set>
					<Set name="delayTimer">0.0</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_Trail</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="initalRGB">1,1,1</Set>
					<Set name="initialScale">0.5,0.5</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,90"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<StateMachines>
			<!--<StateMachine name="HidePearls">
				<States>
					<State name="True"/>
