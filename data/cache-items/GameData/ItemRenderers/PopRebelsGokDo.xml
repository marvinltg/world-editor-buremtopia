<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_hit" fileName="game/particles_large17.rttex" textureSize="64" frame="11,15" />
    <Sprite name="s_punch" fileName="game/particles12.rttex" textureSize="32" frame="2,19" />
    <Sprite name="s_slash" fileName="game/particles12.rttex" textureSize="32" frame="3,19" />
    <Sprite name="s_staff" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="5,12" />
    <Sprite name="s_staffGlow" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="6,12" />
    
    <Animations>
      <SpriteAnimation name="a_slash" sprite="s_slash" isLoop="true" autoPlay="true" animTime="400">
        <Frame>3,19</Frame>
        <Frame>4,19</Frame>
      </SpriteAnimation>
      <CurveAnimationVec4 name="a_staff" playOnState="Action.Punch" sprite="s_staff" animTime="150" isLoop="true">
        <Curve name="staff_rotation2">
          <KeyFrame>0, 0, 0,0,1</KeyFrame>
          <KeyFrame>0.32, 0, 0,0,1</KeyFrame>
          <KeyFrame>0.33, 15, 0,0,1</KeyFrame>
          <KeyFrame>0.65, 15, 0,0,1</KeyFrame>
          <KeyFrame>0.66, -15, 0,0,1</KeyFrame>
          <KeyFrame>1, -15, 0,0,1</KeyFrame>
        </Curve>
      </CurveAnimationVec4>
      <SpriteCurveAnimation name="a_staffGlow" isLoop="true" autoPlay="true" sprite="s_staffGlow" animTime="3000">
        <Curve name="alpha">
          <KeyFrame>0.f, 0.f</KeyFrame>
          <KeyFrame>0.5f, 1.f </KeyFrame>
          <KeyFrame>1.f, 0.f</KeyFrame>
        </Curve>
      </SpriteCurveAnimation>
      <SpriteSinPulseAnimation name="a_punch" sprite="s_punch" autoPlay="true" isLoop="true">
        <Parameter name="alpha">
          <Set name="period">300</Set>
          <Set name="scale">0.5</Set>
          <Set name="offset">0.5</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
      <SpriteAnimation name="a_hit" sprite="s_hit" animTime="400">
        <Frame>14,15</Frame>
        <Frame>11,15</Frame>
        <Frame>12,15</Frame>
        <Frame>13,15</Frame>
      </SpriteAnimation>
    </Animations>
    <StateMachines>
      <StateMachine name="Facing">
        <States>
          <State name="Left" />
          <State name="Right" />
        </States>
        <Transitions>
          <Transition to="Left" from="Right">
            <Condition>
              <IsFacingLeft>true</IsFacingLeft>
            </Condition>
          </Transition>
          <Transition to="Right" from="Left">
            <Condition>
              <IsFacingLeft>false</IsFacingLeft>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      <StateMachine name="Action">
        <States>
          <State name="None" />
          <State name="Punch" />
        </States>
        <Transitions>
          <Transition to="None" from="Punch">
            <Condition>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition to="Punch" from="None">
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
    <RenderOptions>
      <Default>
        <Set name="IncludeAllActions">true</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="PunchSoundOverride">HAND</Set>
        <Set name="PlayDefaultPunchAudio">false</Set>
      </Default>
    </RenderOptions>
    <ParticleSystems>
      <ParticleSystem name="p_hit" updateStage="OnDamagedTile">
        <Emitter>
          <Set name="emissionInterval">0.1</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_hit</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.4</Set>
          <Random name="initialAngle" min="0" max="360" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_pumch2">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punch</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 1</KeyFrame>
            <KeyFrame>1, 2.5, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.25</Set>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.2" angle="0" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_punch">
        <Emitter attachment="contextRotation">
          <Set name="offset">0, 4</Set>
          <Set name="lifeTime">0.15</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punch</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.7</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 1</KeyFrame>
            <KeyFrame>1, 2.5, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.25</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_pumch2Left">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punch</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 1</KeyFrame>
            <KeyFrame>1, 2.5, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.25</Set>
          <Set name="flipY">true</Set>
          <VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="0.2" angle="0" />
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="p_punchLeft">
        <Emitter attachment="contextRotation">
          <Set name="offset">0, 4</Set>
          <Set name="lifeTime">0.15</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="infParticles">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punch</Set>
          <Set name="renderAlignment">LEFT_CENTER</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.7</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="flipY">true</Set>
          <Set name="inSpecificOrder">true</Set>
          <Curve name="initialScale">
            <KeyFrame>0, 0, 1</KeyFrame>
            <KeyFrame>1, 2.5, 1</KeyFrame>
          </Curve>
          <Set name="lifeTime">0.25</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchSlash">
        <Emitter>
          <Set name="offset">0,-10</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="sprite">s_slash</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" />
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
    <VariableMap>
      <Set name="staff_rotation">0, 0, 0, 1</Set>
      <Set name="staff_rotation2">0, 0, 0, 1</Set>
      <Set name="target.direction">0, 0, 0, 1</Set>
    </VariableMap>
  </Data>
  <RenderRules>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="animTime">300</Set>
        <Set name="Curve">
          <KeyFrame>0, 0</KeyFrame>
          <KeyFrame>0.5, 0</KeyFrame>
          <KeyFrame>0.51, -90</KeyFrame>
          <KeyFrame>1, -90</KeyFrame>
        </Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnPunchStart>
      <ParticleSystemUpdate name="ps_punchSlash"/>
    </OnPunchStart>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsAction>BUILD</IsAction>
      </StopIf>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>
      <Group onState="Action.Punch">
        <Rotate forceValue="true">target.direction</Rotate>
        <Rotate>staff_rotation2</Rotate>
        <SpriteRender name="s_staff" offset="3,4" flip="1,1" alignment="CENTER" onState="Facing.Left" />
        <SpriteRender name="s_staff" offset="3,4" alignment="CENTER" onState="Facing.Right" />
        <SpriteRender name="s_staffGlow" offset="3,4" flip="1,1" alignment="CENTER" onState="Facing.Left" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
        <SpriteRender name="s_staffGlow" offset="3,4" alignment="CENTER" onState="Facing.Right" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
        <Group onState="Facing.Right">
          <ParticleSystemUpdate name="p_punch" />
          <ParticleSystemRender name="p_punch" />
        </Group>
        <Group onState="Facing.Left">
          <ParticleSystemUpdate name="p_punchLeft" />
          <ParticleSystemRender name="p_punchLeft" />
        </Group>
      </Group>
      <Group onState="Action.None">
        <SpriteRender name="s_staff" offset="0,3" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" />
        <SpriteRender name="s_staffGlow" offset="0,3" rotationPoint="0,1" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" drawShadow="false"/>
      </Group>
    </RenderBackHandItem>
  </RenderRules>
</ItemRenderer>
