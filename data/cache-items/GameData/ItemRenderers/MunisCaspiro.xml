<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_whiteFoot1" fileName="game/player_feet16.rttex" textureSize="32" frame="7,26"/>
		<Sprite name="s_whiteFoot2" fileName="game/player_feet16.rttex" textureSize="32" frame="7,27"/>
		<Sprite name="s_blackFoot1" fileName="game/player_feet16.rttex" textureSize="32" frame="8,26"/>
		<Sprite name="s_blackFoot2" fileName="game/player_feet16.rttex" textureSize="32" frame="8,27"/>
		<Sprite name="s_death" fileName="game/particles_large18.rttex" textureSize="64" frame="8,1"/>
		<Sprite name="s_backLayer" fileName="game/particles_large18.rttex" textureSize="64" frame="0,2"/>
		<Sprite name="s_frontLayer" fileName="game/particles_large18.rttex" textureSize="64" frame="0,0"/>
		<Sprite name="s_pet1" fileName="game/pets/p_mcaspiro1.rttex" textureSize="32" frame="3,0"/>
		<Sprite name="s_pet2" fileName="game/pets/p_mcaspiro2.rttex" textureSize="32" frame="3,0"/>
		<Animations>
			<SpriteAnimation name="a_backLayer" sprite="s_backLayer" animTime="2000" isLoop="true" autoPlay="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>6,2</Frame>
				<Frame>7,2</Frame>
				<Frame>8,2</Frame>
				<Frame>9,2</Frame>
				<Frame>10,2</Frame>
				<Frame>11,2</Frame>
				<Frame>12,2</Frame>
				<Frame>13,2</Frame>
				<Frame>14,2</Frame>
				<Frame>15,2</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>6,1</Frame>
				<Frame>7,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_frontLayer" sprite="s_frontLayer" animTime="2000" isLoop="true" autoPlay="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
				<Frame>8,0</Frame>
				<Frame>9,0</Frame>
				<Frame>10,0</Frame>
				<Frame>11,0</Frame>
				<Frame>12,0</Frame>
				<Frame>13,0</Frame>
				<Frame>14,0</Frame>
				<Frame>15,0</Frame>
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet1_move" sprite="s_pet1" animTime="300" isLoop="true" playOnState="PetMotion.Horizontal">
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet1_up" sprite="s_pet1" animTime="300" isLoop="true" playOnState="PetMotion.Up">
				<Frame>6,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet1_down" sprite="s_pet1" animTime="300" isLoop="true" playOnState="PetMotion.Down">
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet1_idle" sprite="s_pet1" animTime="300" isLoop="true" playOnState="PetMotion.None">
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet2_move" sprite="s_pet2" animTime="300" isLoop="true" playOnState="PetMotion.Horizontal">
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet2_up" sprite="s_pet2" animTime="300" isLoop="true" playOnState="PetMotion.Up">
				<Frame>6,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet2_down" sprite="s_pet2" animTime="300" isLoop="true" playOnState="PetMotion.Down">
				<Frame>7,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_pet2_idle" sprite="s_pet2" animTime="300" isLoop="true" playOnState="PetMotion.None">
				<Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_death" sprite="s_death" animTime="800" isLoop="false" playOnState="PlayerDead.Yes">
				<Frame>15, 1</Frame>
				<Frame>8, 1</Frame>
				<Frame>9, 1</Frame>
				<Frame>10, 1</Frame>
				<Frame>11, 1</Frame>
				<Frame>12, 1</Frame>
				<Frame>13, 1</Frame>
				<Frame>14, 1</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="PlayerMoving">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="DrawRealPet">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition type="and">
							<IsVariableFloat name="distanceToPet" operator="Less" abs="true">32</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition type="and">
							<IsVariableFloat name="distanceToPet" operator="Greater" abs="true">32</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="PetMotion">
				<States>
					<State name="None" />
					<State name="Pre" ExitTime="0.15"/>
					<State name="Up" />
					<State name="Down" />
					<State name="Horizontal" />
				</States>
				<Transitions>
					<Transition to="None" from="Pre|Horizontal|Up|Down">
						<Condition type="or">
							<IsVariableFloat name="pet.velocity.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction>DIE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Up" from="None">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Down" from="None">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Pre" from="None">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
					<Transition to="Horizontal" from="Pre">
						<Condition type="and">
							<IsVariableFloat name="pet.velocity.x" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsVariableFloat name="pet.velocity.y" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">DIE</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Shoes">
				<States>
					<State name="White"/>
					<State name="Black"/>
				</States>
				<Transitions>
					<Transition to="Black" from="White">
						<Condition>
							<ItemHasTag>BLACK_SHOES</ItemHasTag>
						</Condition>
					</Transition>
					<Transition to="White" from="Black">
						<Condition>
							<ItemHasTag operatorType="NotEqual">BLACK_SHOES</ItemHasTag>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="PlayerDead">
				<States>
					<State name="No"/>
					<State name="Yes" ExitTime="3.5"/>
				</States>
				<Transitions>
					<Transition from="No" to="Yes" >
						<Condition>
							<IsAction>DIE</IsAction>
						</Condition>
					</Transition>
					<Transition from="Yes" to="No" />
				</Transitions>
			</StateMachine>
		</StateMachines>
		<ParticleSystems>
			<ParticleSystem name="p_DeathParticle">
				<Emitter>
					<Set name="offset">0,26</Set>
					<Set name="lifeTime">2</Set>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_death</Set>
					<Set name="renderAlignment">DOWN_CENTER</Set>
					<Set name="lifeTime">0.8</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<VariableMap>
			<Set name="leftFootYPos">0,0,0</Set>
			<Set name="rightFootYPos">0,0,0</Set>
		</VariableMap>
		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="RenderShoesWithMermaidTail">false</Set>
				<Set name="PetOffsetDuplication">-32,0</Set>
				<Set name="UsePetForceFaceTime">false</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="IncludeAllActions">true</Set>
        <Set name="OnEquipTag">BLACK_SHOES</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<RenderShoes>
			<Group>
				<Translate>rightFootYPos</Translate>
				<SpriteRender name="s_whiteFoot2" alignment="DOWN_CENTER" onState="Shoes.White"/>
				<SpriteRender name="s_blackFoot2" alignment="DOWN_CENTER" onState="Shoes.Black"/>
			</Group>
			<Group>
				<Translate>leftFootYPos</Translate>
				<SpriteRender name="s_whiteFoot1" alignment="DOWN_CENTER" onState="Shoes.White"/>
				<SpriteRender name="s_blackFoot1" alignment="DOWN_CENTER" onState="Shoes.Black"/>
			</Group>
		</RenderShoes>
		<RenderInFront>
			<StopIf>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
      <StopIf type="and">
        <IsVariableBool name="isInPetBattle">true</IsVariableBool>
        <IsVariableBool name="isBattleLeash">true</IsVariableBool>
      </StopIf>
			<ContextUpdate type="SetFlip">
				<Set name="flip">0,0</Set>
			</ContextUpdate>
			<Group onState="PlayerDead.No">
				<Group onState="DrawRealPet.No">
					<Translate>0,2,0</Translate>
					<SpriteRender name="s_frontLayer" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" tintOverride="255,255,255,255"/>
				</Group>
			</Group>
		</RenderInFront>
		<RenderBehind value="playerCenter">
			<StopIf>
				<IsTrnsformed>true</IsTrnsformed>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
      <StopIf type="and">
        <IsVariableBool name="isInPetBattle">true</IsVariableBool>
        <IsVariableBool name="isBattleLeash">true</IsVariableBool>
      </StopIf>
			<ContextUpdate type="SetFlip">
				<Set name="flip">0,0</Set>
			</ContextUpdate>
			<Group onState="PlayerDead.No">
				<Group onState="DrawRealPet.No">
					<Translate>0,2,0</Translate>
					<SpriteRender name="s_backLayer" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" tintOverride="255,255,255,255"/>
				</Group>
			</Group>
		</RenderBehind>
		<OnKilled>
			<ParticleSystemUpdate name="p_DeathParticle"/>
		</OnKilled>
		<RenderPet>
			<Group onState="PlayerDead.No">	
				<Group onState="DrawRealPet.Yes">
					<Translate>16,0,0</Translate>
					<SpriteRender name="s_pet1" alignment="DOWN_CENTER"/>
					<Translate>-24,0,0</Translate>
					<SpriteRender name="s_pet2" alignment="DOWN_CENTER"/>
				</Group>
			</Group>
		</RenderPet>
		<UpdatePet>
			<ContextUpdate type="SetPetWalkRunJump">
				<Set name="PetWalkRunJump.minSpeed">500</Set>
				<Set name="PetWalkRunJump.distSpeedMult">10</Set>
			</ContextUpdate>
			<StopIf>
				<IsTrnsformed>true</IsTrnsformed>
			</StopIf>
		</UpdatePet>
	</RenderRules>
</ItemRenderer>