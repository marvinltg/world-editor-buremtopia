<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_wings" fileName="game/particles_large17.rttex" textureSize="64" frame="7,12"/>
    <Sprite name="s_angel" fileName="game/particles12.rttex" textureSize="32" frame="14,17"/>
    <Sprite name="s_petal" fileName="game/particles12.rttex" textureSize="32" frame="16,17"/>

    <Animations>
      <SpriteAnimation name="a_equip" sprite="s_wings" animTime="1200" playOnState="Action.Equip" isLoop="true">
        <Frame>7,12</Frame>
        <Frame>8,12</Frame>
        <Frame>9,12</Frame>
        <Frame>10,12</Frame>
        <Frame>9,12</Frame>
        <Frame>8,12</Frame>
      </SpriteAnimation>
      <SequenceAnimation name="a_BackJump" playOnState="Action.Jump">
        <SpriteAnimation name="a_BackJump1" sprite="s_wings" animTime="100">
          <Frame>7,12</Frame>
          <Frame>11,12</Frame>
          <Frame>12,12</Frame>
          <Frame>11,12</Frame>
          <Frame>7,12</Frame>
        </SpriteAnimation>
        <SpriteAnimation name="a_BackJump2" sprite="s_wings" animTime="200">
          <Frame>7,12</Frame>
          <Frame>11,12</Frame>
          <Frame>12,12</Frame>
          <Frame>13,12</Frame>
        </SpriteAnimation>
      </SequenceAnimation>
      <SpriteAnimation name="a_fall" sprite="s_wings" animTime="1000" playOnState="Action.Fall" isLoop="true">
        <Frame>13,12</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_angel" sprite="s_angel" animTime="400">
        <Frame>14,17</Frame>
        <Frame>15,17</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_petal" sprite="s_petal">
        <Frame>16,17</Frame>
        <Frame>17,17</Frame>
      </SpriteAnimation>
    </Animations>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Equip" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Equip" from="Fall|Jump">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Equip|Fall">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Equip|Jump">
            <Condition type="and">
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
              <IsVariableBool name="onGround">false</IsVariableBool>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <ParticleSystems>
      <ParticleSystem name="ps_angel" updateStage="OnKilled">
        <Emitter>
          <Set name="lifeTime">5.1</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
          <Set name="useCharacterPos">true</Set>
          <Set name="offset">0,-32</Set>
        </Emitter>
        <Particle usePlayerFacing="true">
          <Set name="sprite">s_angel</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="initialVelocity">0, -20</Set>
          <Set name="lifeTime">5</Set>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_petals" updateStage="OnKilled">
        <Emitter>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">8</Set>
          <Set name="lifeTime">0.5</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Random name="offset" min="-15,-20" max="15,0"/>
          <Set name="sprite">s_petal</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">1</Set>
          <Set name="useGravity">true</Set>
          <Set name="gravityVector">0, 40</Set>
          <Set name="initialScale">1,1</Set>
          <Random name="flipX" min="false" max="true"/>
          <Curve name="initialAngle">
            <KeyFrame>0, 0</KeyFrame>
            <KeyFrame>0.2, -15</KeyFrame>
            <KeyFrame>0.4, 15</KeyFrame>
            <KeyFrame>0.6, -15</KeyFrame>
            <KeyFrame>0.8, 15</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Curve name="initialVelocity">
            <KeyFrame>0, 0, 0</KeyFrame>
            <KeyFrame>0.2, -20, 0</KeyFrame>
            <KeyFrame>0.4, 20, 0</KeyFrame>
            <KeyFrame>0.6, -20, 0</KeyFrame>
            <KeyFrame>0.8, 20, 0</KeyFrame>
            <KeyFrame>1, 0, 0</KeyFrame>
          </Curve>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.75</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
        <Set name="IgnorePunchTypeCheck">true</Set>
        <Set name="HideAngelOnDeath">true</Set>
        <Set name="HasDeathParticles">true</Set>
        <Set name="IncludeAllActions">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <RenderBackpack>
      <SpriteRender name="s_wings" offset="0,-22" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_wings" offset="0,-22" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
    </RenderBackpack>
  </RenderRules>
</ItemRenderer>