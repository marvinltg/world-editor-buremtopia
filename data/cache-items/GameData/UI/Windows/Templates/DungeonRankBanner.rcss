#banner {
	display: flex;
	height: 100%;
	width: 100%;
	align-items: flex-end;
}

#stars-container {
	display: flex;
	width: 100%;
	height: 20%;
	align-items: center;
}

.star {
	display: inline-block;
	decorator: image(interface/large/gui_dungeons_rank_star.rttex);
	width: 12.2%;
	height: 53%;
}

#star1 {
	margin-left: 30.75%;
}

.star.hidden {
	display: none;
}