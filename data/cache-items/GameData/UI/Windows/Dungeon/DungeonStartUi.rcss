.window {
    width: 830dp;
}

#window-title .title-icon {
    decorator: image(dungeon_start_ui_title_icon);
}

#dungeonstartui-popup .img-button {
    padding: 10dp 20dp 10dp 20dp;
}

#dungeonstartui-popup .flex-button {
    display: flex;
    flex-direction: row;
	align-items: center;
}

#dungeonstartui-popup .row-flex {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
	align-items: center;
}

#dungeonstartui-popup .column-flex {
    display: flex;
    flex-direction: column;
	align-items: center;
}

#dungeonstartui-popup .zero-lr-padding {
    padding-left: 0dp;
    padding-right: 0dp;
}

#dungeonstartui-popup .rounded-section {
    background-color: rgba(0, 63, 77, 125);
    border-radius: 8dp;
}

#dungeonstartui-popup .img-button .icon {
    width: 40dp;
    height: 40dp;
    display: block;
    flex-shrink: 0;
    margin: 0 10dp;
}

#dungeonstartui-popup .label-with-icon {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    height: auto;
	align-items: center;
}

#dungeonstartui-popup .label-with-icon .icon {
    width: 50dp;
    height: 50dp;
    display: block;
    flex-shrink: 0;
    margin: auto 10dp auto 0;
}

#dungeonstartui-popup .label-with-icon .icon:active {
		filter: brightness(0.85);
		transform: scale(0.95);
	}

#dungeonstartui-popup .label-with-icon .title {
    display: block;
    line-height: 40dp;
    margin-left: 10dp;
	vertical-align: middle;
}

#league-section {
    height: auto;
    overflow: hidden;
    border-radius: 8dp;
    width: 100%;
    margin-bottom: 15dp;
    background-color: rgba(0, 63, 77, 125);
}

#league-section #league-bg {
    width: 100%;
    height: 100%;
    decorator: image(interface/large/gui_dungeons_league_bg.rttex cover);
    image-color: rgba(255,255,255,125);
}

#league-section #league-bg>div {
    margin: 10dp 20dp;
}

#league-section #league-banner-and-text {
    margin-left: 0dp;
}

#league-section #league-banner{
    height: 90dp;
    width: 90dp;
}

#league-section #league-button{
    margin: 0 0dp 0 0;
}

#start-section {
    width: 100%;
    height: auto;
    margin-bottom: 15dp;
}

#start-section #warning-container {
    padding: 20dp;
}

#start-section>div {
    margin: 20dp;
}

#start-section #start-button {
    width: 100%;
    margin-bottom: 10dp;
}

#start-section .row-flex {
    margin-bottom: 10dp;
}

#start-section #scrolls-counter.label-with-icon .icon {
    width: 40dp;
    height: 40dp;
}

#start-section #scrolls-counter.label-with-icon .title {
	font-effect: shadow(1dp 1dp #000);
}

#quests-section {
    width: 100%;
    height: auto;
    margin-bottom: 15dp;
}

#quests-section>div {
    margin: 20dp;
}

#info-button,
#quests-section ul li {
  position: relative;
  padding: 0;
  border-radius: 8dp;
  padding: 10dp;
}

#quests-section ul li.inprogress {
  background-color: rgba(0, 63, 77, 204);
}

#quests-section ul li.completed {
  background-color: rgba(58, 170, 53, 127);
}

#quests-section ul li.notstarted {
  background-color: rgba(126, 42, 16, 204);
}

#quests-section ul li.claimed {
  background-color: rgba(154, 154, 154, 127);
}

#info-button input,
#quests-section ul li input {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  opacity: 0;
}

#info-button input:checked ~ #dungeon-info-panel,
#quests-section ul li input:checked ~ .challenge-info * {
  display:none;
}

#info-button #info-button-text i,
#quests-section ul li i {
  decorator: image(interface/large/gui_ftue_accordion_arrow.rttex);
  width: 40dp;
  height: 40dp;
  transform: rotate(180deg);
}

#info-button input:checked ~ #info-button-text i,
#quests-section ul li input:checked ~ .challenge-title i {
    transform: rotate(0deg);
}

#quests-section .challenge-title{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    height: auto;
    align-items: center;
    vertical-align: middle;
}

#quests-section .challenge-title .icon {
    width: 40dp;
    height: 40dp;
    display: block;
    flex-shrink: 0;
    position: relative;
}

#quests-section .challenge-title .icon .check-mark {
  position: absolute;
  width: 80%;
  height: 80%;
  margin: auto;
    display: block;
    decorator: image(interface/large/gui_dungeons_check_icon.rttex);
}

#quests-section .challenge-title .title-points {
    flex-grow: 1;
    height: auto;
    margin-left: 10dp;
}

#quests-section .challenge {
    height: auto;
    display: block;
    margin: 10dp 0 0dp 0;
}

#quests-section .challenge-button {
    z-index: 1;
    margin-top: 15dp;
}



.challenge-info .reward-icon {
    position: relative;
    width: 60dp;
    height: 60dp;
    padding: 0dp;
    border: 3dp white;
    border-radius: 5dp;
    background-color: rgba(0,0,0,128);
}

.reward-icon .image {
    display: block;
    width: 50dp;
    height: 50dp;
    padding: 0dp;
    margin: auto;
}

.reward-icon .label {
    position: absolute;
    width: 100%;
    font-size: 20dp;
    text-align: right;
    bottom: 0dp;
    right: 3dp;
}

.challenge-info .rewards-panel {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    width: 100%;
    gap: 10dp;
    margin-top: 10dp;
}
.challenge-info .rewards-panel.disabled {
    filter: opacity(0.5);
}

#info-button {
	vertical-align: middle;
	align-items: center;
	justify-content: center;
    margin-bottom: 15dp;
    padding: 10dp 20dp 10dp 20dp;
}

#info-button #info-button-text {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    height: auto;
    align-items: center;
    vertical-align: middle;
}

#main-description {
    margin: 10dp 0 15dp 0;
}