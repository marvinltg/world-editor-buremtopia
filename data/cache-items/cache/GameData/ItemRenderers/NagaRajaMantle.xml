<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_strap" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="9,10"/>
		<Sprite name="s_strapGlow" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="10,10"/>
		<Sprite name="s_mantle" fileName="game/particles_large18.rttex" textureSize="64" frame="7,7"/>
		<Sprite name="s_cloud" fileName="game/particles12.rttex" textureSize="32" frame="5,20"/>
		<Sprite name="s_waterDrop" fileName="game/particles12.rttex" textureSize="32" frame="5,19"/>
		<Sprite name="s_waterSplash" fileName="game/particles.rttex" textureSize="32" frame="4,14"/>

		<Animations>
			<SpriteAnimation name="a_mantle_idle" sprite="s_mantle" isLoop="true" animTime="800" playOnState="Punch.No">
				<Frame>7,7</Frame>
				<Frame>8,7</Frame>
				<Frame>9,7</Frame>
				<Frame>10,7</Frame>
				<Frame>11,7</Frame>
				<Frame>12,7</Frame>
				<Frame>13,7</Frame>
				<Frame>14,7</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_mantle_punch" sprite="s_mantle" isLoop="true" animTime="200" playOnState="Punch.Yes">
				<Frame>13,8</Frame>
				<Frame>14,8</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_cloud" sprite="s_cloud" animTime="200">
				<Frame>5,20</Frame>
				<Frame>6,20</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="a_waterDrop" sprite="s_waterDrop" animTime="200">
				<Frame>5,19</Frame>
				<Frame>6,19</Frame>
			</SpriteAnimation>
			<SpriteCurveAnimation name="a_strapGlow" isLoop="true" autoPlay="true" sprite="s_strapGlow" animTime="2000">
				<Curve name="alpha">
					<KeyFrame>0.f, 1.f</KeyFrame>
					<KeyFrame>0.5f, 0.f </KeyFrame>
					<KeyFrame>1.f, 1.f</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
		</Animations>

		<ParticleSystems>
			<ParticleSystem name="ps_cloud">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="checkParticleNumToEmit">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="lifeTime">0.2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_cloud</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Random name="offset" min="-1, -4" max="1, 4"/>
					<Set name="worldPos" source="Cloud.Position"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="1.5" max="2"/>
					<Random name="finalScale" min="2" max="3"/>
					<Set name="interpolateScale">true</Set>
					<Random name="initialVelocity" min="-10, -1" max="10, 1"/>
					<Set name="lifeTime">2</Set>
					<Set name="inSpecificOrder">true</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_rain">
				<Emitter>
					<Set name="emissionInterval">0.1</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_waterDrop</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Random name="offset" min="-6, 12" max="6, 14"/>
					<Set name="useGravity">true</Set>
					<Set name="lifeTime">1</Set>
					<Random name="initialScale" min="0.75" max="1"/>
					<Set name="gravityVector">0, 120</Set>
					<Set name="worldPos" source="Cloud.Position"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.5, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Set name="inSpecificOrder">true</Set>
					<OnFinish>
						<ParticleSystemName>ps_waterSplash</ParticleSystemName>
					</OnFinish>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_waterSplash" >
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="emissionInterval">0.5</Set>
					<Random name="particlesPerEmission" min="2" max="6"/>
				</Emitter>
				<Particle>
					<Set name="sprite">s_waterSplash</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 0.5, 0.5</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,75" baseAnglePosition="targetPos" baseOffset="0,16"/>
					<Set name="gravityVector">0, 45</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<StateMachines>
			<StateMachine name="Punch">
				<States>
					<State name="No"/>
					<State name="Yes"/>
				</States>
				<Transitions>
					<Transition to="No" from="Yes">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Yes" from="No">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="PunchAnim">
				<States>
					<State name="Off"/>
					<State name="Start" ExitTime="0.01" />
					<State name="Continue"/>
				</States>
				<Transitions>
					<Transition from="Off" to="Start">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Start" to="Continue"/>
					<Transition from="Continue" to="Off">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<RenderOptions>
			<Default>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
			</Default>
		</RenderOptions>

		<VariableMap>
			<Set name="Punch.GetPosition">0,0,0</Set>
			<Set name="Context.GetPosition">0,0,0</Set>
			<Set name="Cloud.Position">0,0</Set>
		</VariableMap>
	</Data>

	<RenderRules>
		<RenderChestItem>
			<SpriteRender name="s_strap" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER"/>
			<SpriteRender name="s_strapGlow" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER"/>
		</RenderChestItem>
		<RenderChestBackItem>
			<SpriteRender name="s_mantle" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" drawShadow="true" />
		</RenderChestBackItem>
		<RenderInFront>
			<ParticleSystemRender name="ps_rain" />
			<ParticleSystemRender name="ps_cloud" />
		</RenderInFront>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="pointTowardsPunchTarget">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>
		<Update>
			<ArithmethicOperation LeftHandVariableName="Cloud.Position.x" RightHandVariableName="Punch.GetPosition.x" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="Cloud.Position.y" RightHandVariableName="Punch.GetPosition.y" OperationType="Set"/>
			<ArithmethicOperation LeftHandVariableName="Cloud.Position.y" RightHandVariableName="-70" OperationType="Add"/>
			<ParticleSystemUpdate name="ps_cloud" onState="PunchAnim.Continue"/>
			<ParticleSystemUpdate name="ps_rain" onState="PunchAnim.Continue"/>
		</Update>
	</RenderRules>
</ItemRenderer>