<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <Sprite name="s_frontSpear" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="5,13"/>
    <Sprite name="s_backSpear" fileName="game/player_longhanditem4.rttex" textureSize="64,32" frame="6,13"/>
    <Sprite name="hit_Sprite" fileName="game/particles12.rttex" textureSize="32" frame="2,20"/>
    <Sprite name="s_punchStraight" fileName="game/particles12.rttex" textureSize="32" frame="1,20"/>
    <Sprite name="s_punchCurve" fileName="game/particles12.rttex" textureSize="32" frame="0,20"/>
    <Sprite name="s_back_arms" fileName="game/particles_large17.rttex" textureSize="64" frame="14,6"/>
    <Sprite name="s_back_items" fileName="game/particles_large17.rttex" textureSize="64" frame="15,6"/>

    <Animations>
      <SpriteAnimation name="hit_Sprites" autoPlay="false" sprite="hit_Sprite">
        <Frame>2,20</Frame>
        <Frame>3,20</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <ParticleSystem name="ps_punchCurved">
        <Emitter onPunchCount="odd">
          <Set name="offset">0,-18</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchCurve</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">1,1</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="ps_punchStraight">
        <Emitter onPunchCount="even">
          <Set name="offset">0,-18</Set>
          <Set name="emissionInterval">0.25</Set>
          <Set name="lifeTime">0.25</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="particlesToEmit">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_punchStraight</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.4</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">false</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">1</Set>
          <Set name="interpolateVelocity">true</Set>
          <Set name="initialScale">1,1</Set>
          <VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
          <VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
        </Particle>
      </ParticleSystem>
      <ParticleSystem name="hit_particle">
        <Emitter>
          <Set name="offset">0,0</Set>
          <Set name="lifeTime">0</Set>
          <Set name="particlesPerEmission">10</Set>
          <Set name="delayTimer">0.0</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">hit_Sprite</Set>
          <Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Set name="lifeTime">0.5</Set>
          <Set name="initalRGB">1,1,1</Set>
	      <Set name="initialScale">0.75,0.75</Set>
          <Set name="rotateWithVelocity">true</Set>
          <Set name="interpolateAlpha">true</Set>
          <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="200,250"/>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>

    <RenderOptions>
      <Default>
	      <Set name="HideParticlesOnTransform">false</Set>
	      <Set name="PunchSoundOverride">HAND</Set>
	      <Set name="RenderBackArmInfected">true</Set>
	      <Set name="RenderFrontArmInfected">true</Set>
	      <Set name="RenderBackArmBuild">false</Set>
	      <Set name="DefaultRenderMannequinHandItem">false</Set>
	      <Set name="RenderFrontArmInTheFront">true</Set>
      </Default>
    </RenderOptions>
  </Data>

  <RenderRules>
    <AddClothingParticles>
      <StopIf>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
      </StopIf>
    </AddClothingParticles>
	<RenderBehind value="playerCenter">
	  <StopIf>
		  <IsZombified>true</IsZombified>
		  <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
		  <IsTrnsformed>true</IsTrnsformed>
		  <IsSleepingOnaBed>true</IsSleepingOnaBed>
		  <IsSitting ItemID="ITEM_ID_THEATER_SEAT">true</IsSitting>
	  </StopIf>
	  <SpriteRender name="s_back_arms" alignment="DOWN_CENTER" tintOverride="SKIN"/>
	  <SpriteRender name="s_back_items" alignment="DOWN_CENTER"/>
	</RenderBehind>
    <RenderBackHandItem>
      <StopIf type="and">
        <IsZombified>true</IsZombified>
        <IsAction>PUNCH</IsAction>
      </StopIf>

		<Group>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<SpriteRender name="s_backSpear" offset="-4,4" rotateOffset="true" useFixedRodtation="true" blend="PREMULTIPLIED_ALPHA" onAction="IDLE|WALK|JUMP|JUMPSTART|FALL|DANCE"/>
			<SpriteRender name="s_backSpear" offset="0,8" rotateOffset="true" rotateToTarget="true" blend="PREMULTIPLIED_ALPHA" onAction="PUNCH"/>
		</Group>
	    <Group>
		    <StopIf>
			    <IsZombified>false</IsZombified>
		    </StopIf>
		    <SpriteRender name="s_backSpear" offset="3,3"  rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
	    </Group>
    </RenderBackHandItem>
    <RenderHandItem>
	    <StopIf type="and">
		    <IsZombified>true</IsZombified>
		    <IsAction>PUNCH</IsAction>
	    </StopIf>
	    <Group>
		    <StopIf>
			    <IsZombified>true</IsZombified>
		    </StopIf>
		    <SpriteRender name="s_frontSpear" offset="0,8" rotateOffset="true" useFixedRotation="true" blend="PREMULTIPLIED_ALPHA" onAction="IDLE|WALK|JUMP|JUMPSTART|FALL|DANCE"/>
		    <SpriteRender name="s_frontSpear" offset="0,8" rotateOffset="true" rotateToTarget="true" blend="PREMULTIPLIED_ALPHA" onAction="PUNCH"/>
	    </Group>
	    <Group>
		    <StopIf>
			    <IsZombified>false</IsZombified>
		    </StopIf>
		    <SpriteRender name="s_frontSpear" offset="7,7" rotateOffset="true" blend="PREMULTIPLIED_ALPHA"/>
	    </Group>
    </RenderHandItem>
    <OnPunchStart>
      <ParticleSystemUpdate name="ps_punchCurved"/>
      <ParticleSystemUpdate name="ps_punchStraight"/>
    </OnPunchStart>
    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm1Angle</Set>
        <Set name="armAngle">1080</Set>
	      <Set name="angleOffset">-1</Set>
        <Set name="isAdditive">true</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">1080</Set>
	     <Set name="angleOffset">1</Set>
        <Set name="isAdditive">true</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <OnDamagedTile>
      <ParticleSystemUpdate name="hit_particle"/>
    </OnDamagedTile>
    <OnDestroyedTile>
      <ParticleSystemUpdate name="hit_particle"/>
    </OnDestroyedTile>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_punchCurved"/>
      <ParticleSystemOff name="ps_punchStraight"/>
      <ParticleSystemOff name="hit_particle"/>
    </SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer>